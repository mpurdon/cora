{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "callout-window",
  "description": "Callout window: events + dragging only, no credential-adjacent surface",
  "windows": ["callout"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "window-state:default"
  ]
}
